# fms-assistant — systemd units for a bare-metal install (no Docker).
#
# "安装 DSH" 本身就是 npm 安装（默认方式），然后两个 systemd unit 各自守护
# 一个进程：harness(dsh web) 和 auth-proxy。Restart=always 保证掉了自动拉起。
#
# 安装步骤：
#   1) 装 Node 22（mise / nvm 均可）
#   2) npm install -g @deepseek-ai/dsh@0.1.1-rc.2     # 锁版本
#   3) 把 assistant/deploy/harness/ 放到 /srv/fms-assistant/harness
#   4) 把 assistant/deploy/auth-proxy.js 放到 /srv/fms-assistant/deploy/
#   5) 安装自定义插件（品牌 + 工作区固定）到 profile 的 node_modules：
#      mkdir -p /srv/fms-assistant/harness/profiles/assistant/node_modules
#      cp -r assistant/custom-plugins/* /srv/fms-assistant/harness/profiles/assistant/node_modules/
#   6) 建 /srv/fms-assistant/.env（FMS_MCP_URL/FMS_MCP_TOKEN/FMS_ORIGIN/PORT/TARGET）
#   7) 安装下面两个 unit：cp *.service /etc/systemd/system/ && systemctl daemon-reload
#      systemctl enable --now fms-assistant fms-assistant-proxy

# ── /etc/systemd/system/fms-assistant.service ────────────────────────────────
[Unit]
Description=fms-assistant harness web (DeepSeek Harness)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Environment=DSH_HOME=/srv/fms-assistant/harness
Environment=DSH_PERMISSION_MODE=read-only
EnvironmentFile=/srv/fms-assistant/.env
ExecStart=/usr/bin/npx dsh --profile assistant --port 3080
WorkingDirectory=/srv/fms-assistant
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

# ── /etc/systemd/system/fms-assistant-proxy.service ──────────────────────────
[Unit]
Description=fms-assistant auth proxy (login gate)
After=network-online.target fms-assistant.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Environment=PORT=3082
Environment=TARGET=http://127.0.0.1:3080
EnvironmentFile=/srv/fms-assistant/.env
ExecStart=/usr/bin/node /srv/fms-assistant/deploy/auth-proxy.js
WorkingDirectory=/srv/fms-assistant
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# ── 说明 ────────────────────────────────────────────────────────────────────
# 为什么这样就不会"掉线"：
#   - Restart=always        进程崩溃/被杀 → systemd 3 秒后自动拉起
#   - 两个 unit 分开守护    proxy 挂了不影响 harness，反之亦然
#   - mcp-client 内置重连   Rails 重启/网络抖动 → 自动恢复 MCP 连接（指数退避）
#   - journald 收日志       journalctl -u fms-assistant -f
#   - 会话数据在 DSH_HOME   换版本/重启不丢（建议放持久盘并纳入备份）
#   - 升级滚动：systemctl start fms-assistant-new（换端口验证）→ 切 nginx → 停旧
