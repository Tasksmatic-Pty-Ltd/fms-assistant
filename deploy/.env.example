# fms-assistant deployment config — per employee / per deployment.
# NEVER commit this file (it holds the employee's MCP token).

# The Rails MCP endpoint, reachable from the container.
FMS_MCP_URL=http://rails-host:3000/mcp

# The EMPLOYEE's own MCP access token, minted by them at
# Settings → MCP access tokens (staff/whops/admin; each person mints for
# themselves). The token carries exactly the employee's Ability.
FMS_MCP_TOKEN=

# The FMS USERNAME (User 表的 username 字段，不是邮箱!) of that SAME
# employee — the identity the login gate enforces. 员工登录用邮箱，但身份门
# 比对的是 username（session_status 返回 current_user.username）。查员工的
# username：FMS 用户管理里看 username 列（如 admin2 / whops_demo）。
# The instance carries exactly ONE employee's token, so the auth proxy refuses
# any other signed-in FMS user (a customer or a different employee would
# otherwise query with the token owner's whole Ability).
# Required, fail-closed: the proxy refuses everyone until this is set.
FMS_OWNER_USERNAME=

# The Rails origin the auth proxy validates FMS session cookies against.
# Must be the SAME domain the employee browses FMS on (session cookie scope),
# reachable from the container.
FMS_ORIGIN=http://fms.example.com

# The ONE fixed workspace folder (created at boot by the workspace-pin plugin;
# the "Add workspace…" affordance is disabled). Since the Univer office bundle
# is installed, this folder is ALSO where the agent's produced documents land
# (Excel/Word/PPT exports and the .univer sources) — it must be writable and
# on a persistent volume. install.sh 形态默认 $FMS_ASSISTANT_HOME/workspace
# （就在 fms-assistant 安装目录里）；Docker 形态 bind 宿主 <安装目录>/files。
FMS_WORKSPACE_DIR=/srv/fms-assistant/files
FMS_WORKSPACE_TITLE=公司工作区

# Docker 形态（deploy/docker-compose.assistant.yml）专用：bind 到
# FMS_WORKSPACE_DIR 的宿主侧文件夹。默认 = 安装目录 + /files。
FMS_FILES_DIR=/srv/fms-assistant/files

# The PUBLIC origin browsers reach the assistant at — the harness's /api trust
# fence must accept it or every RPC is 403 (chat cannot open). Local demo:
# 127.0.0.1:3082; production: the FMS domain (e.g. fms.example.com).
FMS_TRUSTED_HOST=${ASSISTANT_HOST:-127.0.0.1:3082}

# Local port the assistant UI (behind the login gate) listens on.
ASSISTANT_PORT=3082
